{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @second-order/stream typecheck",
    "watchPatterns": ["apps/stream/**", "packages/**", "data/replays/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @second-order/stream db:migrate; pnpm --filter @second-order/stream start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
