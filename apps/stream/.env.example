# Server
PORT=4010
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Persistence (optional). Without it the service runs in memory.
# DATABASE_URL=postgres://user:pass@host:5432/second_order

# Mobula (optional, server-only). Without it only replay sessions are available.
# MOBULA_API_KEY=
MOBULA_REST_URL=https://api.mobula.io
MOBULA_WSS_URL=wss://api.mobula.io
MOBULA_EVM_STREAM_URL=wss://stream-evm-prod.mobula.io/
MOBULA_SOL_STREAM_URL=wss://stream-sol-prod.mobula.io/
MOBULA_RPS=1
